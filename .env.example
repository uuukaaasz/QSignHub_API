# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME="QSignHub API"
APP_VERSION="1.0.0"
APP_ENV=development         # development | staging | production
DEBUG=false
BASE_URL=http://localhost:8000

# ─── Security ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-secure-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://qsignhub:qsignhub@localhost:5432/qsignhub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Storage (MinIO / AWS S3) ────────────────────────────────────────────────
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000      # remove for AWS S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=qsignhub-documents
S3_BUCKET_SIGNED=qsignhub-signed
LOCAL_STORAGE_PATH=/tmp/qsignhub          # used when STORAGE_BACKEND=local

# ─── Signing ────────────────────────────────────────────────────────────────
SIGNING_SESSION_EXPIRE_HOURS=72
SIGNING_SESSION_BASE_URL=http://localhost:3000   # URL of the signing frontend

# ─── Webhooks ───────────────────────────────────────────────────────────────
WEBHOOK_SECRET_HEADER=X-QSignHub-Signature
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=5

# ─── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@qsignhub.com
SMTP_TLS=true

# ─── HSM (Hardware Security Module) ─────────────────────────────────────────
HSM_ENABLED=false
HSM_PKCS11_LIB=/usr/lib/softhsm/libsofthsm2.so
HSM_SLOT_ID=0
HSM_PIN=

# ─── Trust Service Provider (TSP) ───────────────────────────────────────────
# demo | certum | asseco | kir
TSP_PROVIDER=demo
TSP_API_URL=
TSP_API_KEY=

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
